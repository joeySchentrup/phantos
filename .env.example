# Server-side settings for PocketBase. Copy to .env for local development
# (the devcontainer script loads it), or pass them to the container with -e.

# Creates this Dungeon Master account on start if it doesn't exist yet.
DM_EMAIL=
DM_PASSWORD=

# The site's public address, for the links in the RSS feed. Leave it empty
# unless they come out wrong: the feed otherwise uses the address it was
# asked on. (The devcontainer script sets it to the Vite dev server.)
SITE_URL=
