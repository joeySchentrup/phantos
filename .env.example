# Server-side settings for PocketBase. Copy to .env for local development
# (the devcontainer script loads it), or pass them to the container with -e.

# Creates this Dungeon Master account on start if it doesn't exist yet.
DM_EMAIL=
DM_PASSWORD=

# The site's public address, for the links in the RSS feed. Leave it empty
# unless they come out wrong: the feed otherwise uses the address it was
# asked on. (The devcontainer script sets it to the Vite dev server.)
SITE_URL=

# Chat (deploy/matrix/README.md). Locally, the devcontainer script points these at the
# chat server .devcontainer/start-matrix.sh runs; set them here only to use another.
# MATRIX_URL: how PocketBase reaches Synapse. MATRIX_PUBLIC_URL: the address browsers
# use; PocketBase hands it to the site and lets its pages connect there.
# MATRIX_SERVER_NAME: server_name in homeserver.yaml. MATRIX_AS_TOKEN: as_token in
# phantos-appservice.yaml. With any of them empty, chat is off.
MATRIX_URL=
MATRIX_PUBLIC_URL=
MATRIX_SERVER_NAME=
MATRIX_AS_TOKEN=
